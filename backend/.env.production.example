# ==============================================================================
# School ERP & SaaS Platform - Production Environment Configuration Template
# ==============================================================================
# NOTE: DO NOT commit production secrets to version control.
# Copy this file to .env on the production backend server and fill in secrets securely.

# Application Core
APP_NAME="School ERP SaaS"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
PLATFORM_URL=https://platform.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging & Monitoring
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
# Sentry DSN for production backend error tracking
SENTRY_LARAVEL_DSN=

# Production Supabase PostgreSQL Configuration
# TIP: For web workers, use Supabase Connection Pooler (Transaction Mode, Port 6543)
# For running artisan migrate, use Direct Connection (Session Mode, Port 5432)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_STRONG_SUPABASE_DB_PASSWORD
DB_SCHEMA=public
DB_SSLMODE=require
DB_EMULATE_PREPARES=true
DB_SEARCH_PATH=public

# Session & Cookie Governance (Cross-Subdomain Authentication)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Prefix with dot to share authentication cookies across *.example.com subdomains
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Laravel Sanctum (Cross-Subdomain Stateful Domains)
SANCTUM_STATEFUL_DOMAINS="app.example.com,platform.example.com,api.example.com,.example.com"
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=erp_pat_

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS="https://app.example.com,https://platform.example.com"
# Regex pattern allowing any school tenant subdomain (e.g. https://school1.example.com)
CORS_ALLOWED_ORIGINS_PATTERNS="#^https:\/\/[a-z0-9\-]+\.example\.com$#"

# Redis (Caching, Queues & Sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YOUR_REDIS_AUTH_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=school_erp_cache_

# Production File Storage (Supabase S3-Compatible Storage)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_STORAGE_SECRET_KEY
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=school-erp-documents
AWS_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/school-erp-documents
AWS_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# Production Mail Delivery (Amazon SES / Resend / Postmark / SMTP)
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_SES_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SES_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@example.com"
MAIL_FROM_NAME="School ERP System"

# Payment Gateways (Razorpay Production / Live Mode)
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_WEBHOOK_SECRET_HMAC

# Communication Gateway Credentials
# SMS Gateway (MSG91 / Twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SCHERP
MSG91_DLT_TE_ID=

# WhatsApp Business API Gateway
WHATSAPP_PROVIDER=gupshup
WHATSAPP_APP_NAME=
WHATSAPP_API_KEY=

# Custom Domain SSL / CNAME Routing Target
CUSTOM_DOMAIN_CNAME_TARGET=custom.example.com

